#!/bin/bash

# Corresponds to EFWR-S154/2.0.62:
#   mediamtx
#   mqttwebrtc
#   hub-log-sender


MQTTWEBRTC_VERSION="1.6.3-1-gb4dd965"
MQTTWEBRTC_IPK="https://dl-fmt1.mios.com/linux_firmware/build/custom_packages/mqttwebrtc/firmware-custom-mqttwebrtc_${MQTTWEBRTC_VERSION}_all.ipk"

MEDIAMTX_VERSION="1.8.2.5"
MEDIAMTX_IPK="https://dl-fmt1.mios.com/linux_firmware/build/custom_packages/mediamtx/firmware-custom-mediamtx_${MEDIAMTX_VERSION}_all.ipk"

HUB_LOG_SENDER_VERSION=1.2.0
HUB_LOG_SENDER_IPK="https://dl-fmt1.mios.com/linux_firmware/build/custom_packages/hub-log-sender/firmware-custom-hub-log-sender_${HUB_LOG_SENDER_VERSION}_all.ipk"

CUSTOM_PACKAGES="$MEDIAMTX_IPK $MQTTWEBRTC_IPK $HUB_LOG_SENDER_IPK"

# How to use to deploy custom packages locally:
# source ./custom_packages.env

# Use variables from the file as CUSTOM_PACKAGES array for deploy.sh:
# ../../misc/scripts/deploy.sh BUILD_DIR=$BUILD_DIR ZWAVE_REGION=us HUB_TYPE=$HUB_TYPE CLOUD_ENVIRONMENT=qa \
#   TOOLCHAIN_PATH=/usr/local/toolchains/gcc7.4.0_musl_eabi-arm-v1.5 TOOLCHAIN_TARGET_NAME=arm-openwrt-linux \
#   WITH_BLE=0 WITH_ZIGBEE=1 WITH_2GIG=$USE_2GIG HUB_IP="$HOSTNAME" PASSWORD="$WIFI" \
#   CUSTOM_PACKAGES="$CUSTOM_PACKAGES"