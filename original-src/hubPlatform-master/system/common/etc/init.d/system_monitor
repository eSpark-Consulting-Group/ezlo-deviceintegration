#!/bin/sh /etc/rc.common

source /etc/init.d/common

USE_PROCD=1
START=97
STOP=02
SERVICE_DAEMONIZE=1
PROVIDES=system_monitor

FIRMWARE="system_monitor"

start_service() {
  procd_open_instance
  FIRMWARE=$(locate_firmware "$FIRMWARE")

  [ -z "$FIRMWARE" ] && exit

  logger -t system_monitor "Full path: $FIRMWARE_DIR/$FIRMWARE"

  procd_set_param respawn $RESPAWN_PARAMS

  procd_set_param command /bin/sh -c "$FIRMWARE_DIR/$FIRMWARE >> $LOG_DIR/${FIRMWARE##*/}.log 2>&1"

  procd_close_instance
}
