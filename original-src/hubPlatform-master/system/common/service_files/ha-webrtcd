#!/bin/sh /etc/rc.common

source /etc/init.d/common

USE_PROCD=1
START=99
STOP=02
SERVICE_DAEMONIZE=1

FIRMWARE="ha-webrtcd"

start_service() {

  procd_open_instance
  FIRMWARE=$(locate_firmware "$FIRMWARE")

  [ -z "$FIRMWARE" ] && exit
  LIBRARY_DIR="$FIRMWARE_DIR/${FIRMWARE%/*/*}/lib"

  ln -sf $LIBRARY_DIR/ld-linux-armhf.so $LIBRARY_DIR/ha-webrtcd_ld

  hub_type=$(${FIRMWARE_DIR}/bin/at88util --type)
  if [ "${hub_type}" = "h2.1" ] || [ "${hub_type}" = "h2_secure.1" ]; then
    cgroup_bytes=$(calculate_cgroup_memory)
    cgcreate -g memory:/webrtc
    cgset -r cpuset.mems=0 -r cpuset.cpus=2-3 -r memory.limit_in_bytes=${cgroup_bytes} webrtc
    procd_set_param command /bin/sh -c "cgexec -g memory:/webrtc $LIBRARY_DIR/ha-webrtcd_ld --library-path $LIBRARY_DIR $FIRMWARE_DIR/$FIRMWARE $OPTIONS >> $LOG_DIR/${FIRMWARE##*/}.log  2>&1"
  else
    procd_set_param command /bin/sh -c "$LIBRARY_DIR/ha-webrtcd_ld --library-path $LIBRARY_DIR $FIRMWARE_DIR/$FIRMWARE $OPTIONS >> $LOG_DIR/${FIRMWARE##*/}.log  2>&1"
  fi
  procd_set_param limits core="0 0"
  procd_set_param respawn $RESPAWN_PARAMS
  procd_close_instance
}
