#!/bin/sh /etc/rc.common

source /etc/init.d/common

USE_PROCD=1
START=99
STOP=02
SERVICE_DAEMONIZE=1

FIRMWARE="ha-notificationsd"
UBUS_SERVICE_NAME="notifications"

start_service() {
  logger -t notifications "Firmware 'notifications' service starting"

  procd_open_instance
  FIRMWARE=$(locate_firmware "$FIRMWARE")

  [ -z "$FIRMWARE" ] && exit

  procd_set_param respawn $RESPAWN_PARAMS

  procd_set_param command /bin/sh -c "$FIRMWARE_DIR/$FIRMWARE $OPTIONS >> $LOG_DIR/${FIRMWARE##*/}.log 2>&1"
  procd_set_param data service_name=${UBUS_SERVICE_NAME}
  procd_set_param limits core="unlimited"

  procd_close_instance

}

service_stopped() {
  logger -t notifications "Firmware 'notifications' service stopped"
}
