[Unit]
Description=eZLO startup script service
After=syslog.target network.target remote-fs.target local-fs.target nss-lookup.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/firmware/scripts
ExecStart=/opt/firmware/scripts/ezlo_startup.sh
StandardOutput=journal

[Install]
WantedBy=multi-user.target
