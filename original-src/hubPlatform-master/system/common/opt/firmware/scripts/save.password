#!/usr/bin/python
 
import cgi
import os

form = cgi.FieldStorage()

ssid = form.getvalue('ssid')
password = form.getvalue('password')

f = os.popen('/opt/firmware/scripts/wf-cmd.sh add "'+ssid+'" "'+password+'"')
result = f.read()


print """Content-type: text/html

<html><head><title>SSID saved</title></head><body>
<h1>SSID [%s] with KEY [%s] saved</h1>
</body></html>""" % (ssid, password)