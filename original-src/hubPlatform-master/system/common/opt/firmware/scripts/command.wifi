#!/usr/bin/python
 
import cgi
import os

def printAsHttp(text):
  header = 'Content-type: text/html\n\n'
  print header,text
  return

form = cgi.FieldStorage()
command = ''
password = ''
command = form.getvalue('command')

if command == 'list':
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh list')
    iwlist = shellResult.read()
    networks = "["
    for line in iwlist.split('\n'):
        if line!='':
            networks=networks+line+','
    networks = networks[1:-1]
    networks = networks+']'
    printAsHttp('{"result":{"wifiList":['+networks+'}}')
elif command == 'add':
    ssid = form.getvalue('ssid')
    password = form.getvalue('password')
    if not password:
        shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh add "%s"' % ssid)
    else:
        shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh add "%s" "%s"' % (ssid, password))
    printAsHttp('{"result":{"ssid":"'+ssid+'", "added":true}}')
elif command == 'add_hidden':
    ssid = form.getvalue('ssid')
    password = form.getvalue('password')
    if not password:
        shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh add_hidden "%s"' % ssid)
    else:
        shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh add_hidden "%s" "%s"' % (ssid, password))
    printAsHttp('{"result":{"ssid":"'+ssid+'", "added":true}}')
elif command == 'remove':
    ssid = form.getvalue('ssid')
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh remove "%s"' % ssid)
    printAsHttp('{"result":{"ssid":"'+ssid+'", "removed":true}}')
elif command == 'connect':
    ssid = form.getvalue('ssid')
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh connect "%s"' % ssid)
    printAsHttp('{"result":{"ssid":"'+ssid+'", "connecting":true}}')
elif command == 'check':
    ssid = form.getvalue('ssid')
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh check "%s"' % ssid)
    checkResult = shellResult.read()
    printAsHttp('{"result":%s' % checkResult)
elif command == 'info':
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh info')
    infoResult = shellResult.read()
    printAsHttp('{"result":%s}' % infoResult)
elif command == 'reset_config':
    shellResult = os.popen('/opt/firmware/scripts/wf-cmd.sh reset_config')
    printAsHttp('{"result":{"reset_config":true}}')
else:
  printAsHttp('{"result":{"error":"unknown command"}}')
  
